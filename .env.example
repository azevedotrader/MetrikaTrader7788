# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores corretos

# ⚠️ IMPORTANTE: DATABASE_URL é obrigatório para a aplicação funcionar
# O banco de dados está provisionado no Replit, mas a variável de ambiente 
# não está sendo carregada automaticamente.

# Para obter o DATABASE_URL:
# 1. Vá em Tools > Secrets no Replit (canto esquerdo, ícone de cadeado)
# 2. Procure por DATABASE_URL
# 3. Copie o valor e cole abaixo

DATABASE_URL=postgresql://username:password@host:port/database

# Outras variáveis de ambiente opcionais:
# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=

# Variáveis do WhatsApp (se configurado)
# WHATSAPP_ACCESS_TOKEN=

# ─── Hubla Webhooks ────────────────────────────────────────────────
# Segredo gerado no painel Hubla → Configurações → Webhooks → Criar webhook
# Cole o "Segredo de assinatura" que a Hubla exibe ao criar o webhook
HUBLA_WEBHOOK_SECRET=

# IDs dos produtos cadastrados na Hubla (Produtos → selecionar → copiar ID da URL)
HUBLA_PRODUCT_MONTHLY=
HUBLA_PRODUCT_QUARTERLY=
HUBLA_PRODUCT_ANNUAL=
# ───────────────────────────────────────────────────────────────────
